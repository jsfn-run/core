{
  "extends": "@cloud-cli/typescript-config",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": ["ESNext"],
    "target": "esnext",
    "moduleResolution": "bundler",
    "module": "esnext",
    "types": ["node"]
  },
  "include": ["src/*.ts", "src/*.mts"],
  "exclude": ["src/**/*.spec.ts"]
}
